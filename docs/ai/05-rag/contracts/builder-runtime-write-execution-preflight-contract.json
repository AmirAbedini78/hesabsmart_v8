{
  "name": "ERPSMART Builder Runtime Write Execution Preflight Contract",
  "current_implementation_status": "runtime_write_execution_preflight_mvp",
  "endpoint": "POST /api/builder/publish-executions/{id}/runtime-write-preflight",
  "allowed_execution_statuses": [
    "runtime_write_planned"
  ],
  "resulting_statuses": [
    "runtime_write_preflight_passed",
    "runtime_write_preflight_blocked"
  ],
  "required_checks": [
    "execution_exists",
    "execution_status_runtime_write_planned",
    "latest_final_confirmation_exists",
    "final_confirmation_status_granted",
    "final_confirmation_fresh",
    "confirmation_bound_to_execution",
    "runtime_write_plan_path_exists",
    "runtime_write_plan_json_valid",
    "runtime_write_plan_has_no_blockers",
    "staged_validation_report_path_exists",
    "staged_validation_report_json_valid",
    "rollback_manifest_path_exists",
    "rollback_manifest_json_valid",
    "runtime_path_allowlist_applied",
    "backup_requirements_planned",
    "no_runtime_write_endpoint",
    "no_copy_to_runtime_endpoint",
    "no_publish_endpoint",
    "runtime_writes_zero",
    "publish_executed_false",
    "copy_to_runtime_false"
  ],
  "allowed_write_scope": "storage/app/builder-runtime-write-preflights",
  "runtime_writes_performed": 0,
  "publish_executed": false,
  "copy_to_runtime_executed": false,
  "ready_for_future_runtime_write_is_not_execution": true,
  "backup_artifact_follows_passed_preflight": true,
  "preflight_ready_is_not_execution": true,
  "post_backup_readiness_checks_preflight_output": true,
  "agent_may_call_when_human_initiated": true,
  "agent_may_execute_runtime_write": false,
  "mcp_may_execute_runtime_write": false
}

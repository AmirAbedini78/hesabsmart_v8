{
  "name": "ERPSMART Builder Runtime Write Execution MVP Contract",
  "current_implementation_status": "runtime_write_execution_mvp",
  "endpoint": "POST /api/builder/publish-executions/{id}/execute-runtime-write",
  "service": "BuilderRuntimeWriteExecutionService",
  "runtime_write_endpoint_implemented": true,
  "copy_to_runtime_endpoint_implemented": false,
  "publish_endpoint_implemented": false,
  "rollback_endpoint_implemented": false,
  "required_execution_status": "runtime_write_operator_acknowledged",
  "required_preconditions": [
    "runtime_write_kill_switch_enabled",
    "post_backup_readiness_passed",
    "kill_switch_guard_passed",
    "operator_acknowledgement_acknowledged",
    "runtime_write_plan_valid",
    "backup_manifest_valid",
    "rollback_manifest_valid",
    "allowlist_valid",
    "runtime_write_lock_acquired"
  ],
  "resulting_statuses": [
    "runtime_write_started",
    "runtime_write_succeeded",
    "runtime_write_failed",
    "runtime_write_aborted"
  ],
  "allowed_write_scope": [
    "modules/{GeneratedModule}",
    "generated module migration files only"
  ],
  "forbidden_write_scope": [
    "modules/Core",
    "modules/SaaS",
    "modules/Updater",
    "modules/Installer",
    "public/build",
    "vendor",
    "node_modules",
    "routes/web.php",
    "resources/js/app.js"
  ],
  "migrations_run_in_runtime_write_phase": false,
  "routes_registered_in_runtime_write_phase": false,
  "mark_published_in_runtime_write_phase": false,
  "rollback_execution_in_runtime_write_phase": false,
  "publish_executed": false,
  "post_write_smoke_required_after_runtime_write": true,
  "ai_may_execute_runtime_write": false,
  "mcp_may_execute_runtime_write": false
}

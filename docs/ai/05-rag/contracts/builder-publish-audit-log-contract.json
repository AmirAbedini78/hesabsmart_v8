  "retention_policy_notes": [
    "Audit events should be retained longer than preview/candidate artifacts.",
    "Audit rows should be immutable and append-only.",
    "Corrections should be represented as new events, not updates."
  ],
  "actor_requirements": [
    "Every event must have an actor or system actor.",
    "Approval decisions must record the deciding user.",
    "Future self-approval rules must be explicit policy, not implicit behavior."
  ],
  "checksum_requirements": [
    "Approval and publish events must record definition checksum.",
    "Approval and publish events should record candidate snapshot checksum.",
    "Checksum mismatch invalidates approval."
  ],
  "source_of_truth_notes": [
    "Audit logs are evidence and traceability records.",

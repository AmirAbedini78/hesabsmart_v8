{
  "name": "ERPSMART Builder Runtime Write Post-Write Smoke Contract",
  "purpose": "Verify guarded runtime write outputs without modifying runtime files or performing publish, migrations, route registration, activation, mark-published, or rollback.",
  "current_implementation_status": "runtime_write_post_write_smoke_mvp",
  "endpoint": "POST /api/builder/publish-executions/{id}/post-write-smoke",
  "service": "BuilderRuntimeWritePostWriteSmokeService",
  "required_execution_status": "runtime_write_succeeded",
  "resulting_statuses": [
    "runtime_write_smoke_passed",
    "runtime_write_smoke_failed",
    "runtime_write_smoke_blocked"
  ],
  "allowed_read_scopes": [
    "execution-scoped runtime write report under storage/app/builder-runtime-write-executions",
    "execution-scoped rollback manifest under storage/app/builder-publish-rollbacks",
    "execution-scoped backup manifest and backup files under storage/app/builder-publish-backups",
    "committed files in allowlisted generated module paths",
    "Builder control-plane records"
  ],
  "allowed_write_scope": "storage/app/builder-runtime-write-smoke",
  "runtime_files_may_be_read": true,
  "runtime_files_may_be_modified": false,
  "php_syntax_check_allowed": true,
  "generated_php_code_execution_allowed": false,
  "required_checks": [
    "execution_status_runtime_write_succeeded",
    "runtime_write_report_exists",
    "runtime_write_report_valid_json",
    "runtime_write_executed_true",
    "runtime_write_report_publish_false",
    "runtime_write_report_migrations_false",
    "runtime_write_report_routes_false",
    "runtime_write_report_mark_published_false",
    "runtime_write_report_rollback_false",
    "committed_files_present",
    "every_runtime_path_allowlisted",
    "no_forbidden_runtime_paths",
    "every_committed_file_exists",
    "every_committed_hash_matches",
    "php_syntax_valid",
    "json_files_valid",
    "migration_files_not_executed",
    "rollback_manifest_exists",
    "rollback_manifest_valid_json",
    "rollback_entries_complete",
    "backup_references_complete_for_overwrites",
    "builder_definition_not_published",
    "smoke_runtime_writes_zero",
    "smoke_publish_false",
    "smoke_migrations_false",
    "smoke_routes_false",
    "smoke_mark_published_false",
    "smoke_rollback_false"
  ],
  "migrations_run": false,
  "routes_registered": false,
  "module_marked_published": false,
  "publish_executed": false,
  "rollback_executed": false,
  "runtime_files_modified_by_smoke": 0,
  "post_write_smoke_is_not_publish": true,
  "agent_may_call_when_human_initiated": true,
  "agent_may_run_autonomously": false,
  "agent_may_publish": false,
  "mcp_may_publish": false
}

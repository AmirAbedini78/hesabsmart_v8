{
  "name": "ERPSMART Builder Runtime Write Kill-Switch Guard Contract",
  "current_implementation_status": "runtime_write_kill_switch_guard_mvp",
  "endpoint": "POST /api/builder/publish-executions/{id}/runtime-write-kill-switch-guard",
  "config_key": "builder.runtime_write.enabled",
  "env_key": "BUILDER_RUNTIME_WRITE_ENABLED",
  "default_enabled": false,
  "allowed_execution_statuses": [
    "runtime_write_readiness_passed",
    "runtime_write_guard_blocked",
    "runtime_write_guard_passed"
  ],
  "resulting_statuses": [
    "runtime_write_guard_passed",
    "runtime_write_guard_blocked"
  ],
  "allowed_write_scope": "storage/app/builder-runtime-write-guards",
  "required_checks": [
    "execution_exists",
    "post_backup_readiness_report_exists",
    "post_backup_readiness_valid_json",
    "post_backup_readiness_ready_true",
    "config_runtime_write_enabled",
    "max_files_per_execution_configured",
    "max_total_bytes_per_execution_configured",
    "ai_cannot_override",
    "mcp_cannot_override",
    "no_runtime_write_endpoint",
    "no_copy_to_runtime_endpoint",
    "no_publish_endpoint",
    "no_rollback_endpoint",
    "runtime_writes_zero",
    "publish_executed_false",
    "copy_to_runtime_false"
  ],
  "runtime_writes_performed": 0,
  "publish_executed": false,
  "copy_to_runtime_executed": false,
  "runtime_write_guard_passed_is_not_execution": true,
  "agent_may_call_when_human_initiated": true,
  "agent_may_override_kill_switch": false,
  "mcp_may_override_kill_switch": false,
  "agent_may_execute_runtime_write": false,
  "mcp_may_execute_runtime_write": false
}
